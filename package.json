{
  "name": "spine-pet-workshop",
  "version": "3.2.3",
  "private": true,
  "description": "A Windows Spine 3.8 desktop-pet workshop with local character and voice import.",
  "author": "Amiya Desktop Pet Project",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "test:plugins": "node --test scripts/test-plugins.mjs scripts/test-extensions.mjs scripts/test-external-plugins.mjs scripts/test-weather-plugin.mjs scripts/test-plugin-promotion.mjs scripts/test-plugin-documentation.mjs",
    "test:plugins:ui": "electron scripts/run-smoke-v321.mjs",
    "test:plugins:zip-ui": "electron scripts/run-smoke-zip-plugin.mjs",
    "test:plugins:sandbox": "electron scripts/test-plugin-sandbox.mjs",
    "test:plugins:codex": "electron scripts/test-codex-zip.mjs",
    "package:codex": "node scripts/package-plugin.mjs examples/codex-plugin release/plugins/Codex-Plugin-v1.1.0.zip",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "package:win": "pnpm build && electron-builder --win nsis portable --x64 --publish never",
    "test:weather": "node --test scripts/test-weather-plugin.mjs",
    "test:weather:sandbox": "electron scripts/test-weather-sandbox.mjs",
    "package:weather": "node scripts/package-plugin.mjs examples/weather-plugin release/plugins/Weather-Plugin-v1.1.0.zip",
    "test:release": "node --test scripts/test-character-parameters.mjs scripts/test-startup.mjs scripts/test-extensions.mjs scripts/test-plugins.mjs scripts/test-external-plugins.mjs scripts/test-weather-plugin.mjs scripts/test-plugin-promotion.mjs scripts/test-plugin-documentation.mjs scripts/test-community-catalog.mjs scripts/test-hello-counter.mjs",
    "test:packaged": "node scripts/test-packaged-release.mjs",
    "package:hello": "node scripts/package-plugin.mjs examples/hello-counter-plugin release/plugins/Hello-Counter-v1.0.0.zip",
    "community:generate": "node scripts/community-catalog.mjs --write",
    "community:check": "node scripts/community-catalog.mjs",
    "test:community": "node --test scripts/test-community-catalog.mjs scripts/test-hello-counter.mjs",
    "test:community:sandbox": "electron scripts/test-hello-counter-sandbox.mjs"
  },
  "dependencies": {
    "@pixi-spine/all-3.8": "4.0.6",
    "pixi.js": "7.4.3"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "9.0.3"
  },
  "packageManager": "pnpm@11.19.0",
  "build": {
    "appId": "local.spine.desktop.pet.workshop",
    "productName": "Spine桌宠工坊",
    "executableName": "SpinePetWorkshop",
    "artifactName": "Spine-Pet-Workshop-v${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "electron/window-monitor.ps1",
      "electron/extensions/*.ps1",
      "dist/models/**/*",
      "dist/voicepacks/**/*"
    ],
    "directories": {
      "output": "release/v${version}"
    },
    "files": [
      "assets/**/*",
      "dist/**/*",
      "electron/**/*",
      "plugins/todo/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/amiya-app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Spine-Pet-Workshop-Setup-v${version}-${arch}.${ext}",
      "installerIcon": "assets/amiya-app-icon.ico",
      "uninstallerIcon": "assets/amiya-app-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spine桌宠工坊",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Spine-Pet-Workshop-Portable-v${version}-${arch}.${ext}"
    }
  }
}
