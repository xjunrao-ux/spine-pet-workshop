{
  "name": "@local/dsh-pet-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "pet-dsh/1 bridge host plugin: local HTTP JSON + SSE surface that lets a Spine desktop pet drive an already-running DeepSeek Harness session.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "pet-dsh",
    "bridge"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "src/",
    "protocol/",
    "docs/",
    "scripts/bridge-smoke.mjs",
    "scripts/pet-bridge-admin.mjs",
    "cordis.patch.yml",
    "README.md",
    "COMPATIBILITY.md",
    "TEST_REPORT.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "petBridge": {
      "protocol": "pet-dsh/1",
      "protocolRevision": "1.0.0",
      "minimumPetHost": "4.2.2",
      "verifiedHarness": {
        "dsh": "0.1.1-rc.2",
        "cordis": "4.0.1",
        "node": "24.21.0"
      },
      "hostProvidedPackages": {
        "@deepseek-ai/cordis": "4.0.1",
        "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
        "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
        "@deepseek-ai/dsh-session": "0.1.1-rc.2"
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:real": "node --test test/real-dsh.test.js",
    "admin": "node scripts/pet-bridge-admin.mjs",
    "smoke": "node scripts/bridge-smoke.mjs",
    "dev": "node scripts/dev-fake-bridge.mjs",
    "probe": "node scripts/probe-dsh.mjs",
    "pack": "node scripts/pack.mjs"
  }
}
