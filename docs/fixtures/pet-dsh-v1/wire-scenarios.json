{
  "format": "pet-dsh-wire-design/1",
  "notExecutedClientTests": true,
  "protocol": "pet-dsh/1",
  "revision": "1.0.0",
  "notes": [
    "所有凭据和会话身份均为虚构示例",
    "正常 DTO 来自当前服务实现形态",
    "negative:true 仅表示客户端必须拒绝该语义，不代表 Schema 包络必然不合法",
    "expected 为待实现客户端的验收断言，生成器不模拟领域状态机"
  ],
  "scenarios": [
    {
      "id": "normal",
      "covers": [
        "C05",
        "C10",
        "C12"
      ],
      "steps": [
        {
          "direction": "pet-to-host",
          "kind": "request",
          "args": {
            "requestId": "http.info-1",
            "method": "GET",
            "path": "/info"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "response",
            "requestId": "http.info-1",
            "status": 200,
            "ok": true,
            "data": {
              "protocols": [
                "pet-dsh/1"
              ],
              "instanceId": "bridge-A",
              "serverVersion": "1.0.0",
              "dshVersion": "0.1.1-rc.2",
              "capabilities": [
                "sessions.list",
                "session.snapshot",
                "message.send",
                "events.follow",
                "requests.lookup",
                "session.cancel"
              ],
              "limits": {
                "requestBytes": 65536,
                "responseBytes": 262144,
                "eventBytes": 65536,
                "messageChars": 4000,
                "eventsPerSecond": 30,
                "heartbeatMs": 15000,
                "journalRetentionHours": 24,
                "sessionPageSize": 20,
                "snapshotMessageLimit": 20
              }
            }
          }
        },
        {
          "direction": "pet-to-host",
          "kind": "request",
          "args": {
            "requestId": "http.sessions-1",
            "method": "GET",
            "path": "/sessions"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "response",
            "requestId": "http.sessions-1",
            "status": 200,
            "ok": true,
            "data": {
              "instanceId": "bridge-A",
              "items": [
                {
                  "sessionId": "session-A",
                  "title": "仓库检查",
                  "workspace": "spine-pet-workshop",
                  "status": "idle",
                  "available": true
                },
                {
                  "sessionId": "session-old",
                  "title": "历史会话",
                  "workspace": "old-project",
                  "status": "unavailable",
                  "available": false
                }
              ],
              "nextCursor": null
            }
          }
        },
        {
          "direction": "local",
          "note": "用户明确选择 session-A，递增绑定版本"
        },
        {
          "direction": "pet-to-host",
          "kind": "request",
          "args": {
            "requestId": "http.snapshot-1",
            "method": "GET",
            "path": "/snapshot",
            "query": {
              "sessionId": "session-A"
            }
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "response",
            "requestId": "http.snapshot-1",
            "status": 200,
            "ok": true,
            "data": {
              "instanceId": "bridge-A",
              "sessionId": "session-A",
              "cursor": "bridge-A.100",
              "messages": [
                {
                  "messageId": "user-01",
                  "role": "user",
                  "text": "之前的讨论",
                  "turn": 1
                }
              ],
              "activity": null,
              "pendingInteractions": [],
              "pendingPetCalls": [],
              "truncated": false
            }
          }
        },
        {
          "direction": "pet-to-host",
          "kind": "stream",
          "args": {
            "streamId": "sse.1",
            "path": "/events",
            "query": {
              "sessionId": "session-A"
            },
            "lastEventId": "bridge-A.100"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.open",
            "streamId": "sse.1"
          }
        },
        {
          "direction": "local",
          "note": "先持久化发送意图"
        },
        {
          "direction": "pet-to-host",
          "kind": "request",
          "args": {
            "requestId": "http.send-1",
            "method": "POST",
            "path": "/commands",
            "body": {
              "protocol": "pet-dsh/1",
              "instanceId": "bridge-A",
              "requestId": "pet.send-01",
              "op": "message.send",
              "sessionId": "session-A",
              "data": {
                "mode": "followup",
                "text": "分析仓库测试失败的原因"
              }
            }
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "response",
            "requestId": "http.send-1",
            "status": 202,
            "ok": true,
            "data": {
              "protocol": "pet-dsh/1",
              "instanceId": "bridge-A",
              "requestId": "pet.send-01",
              "ok": true,
              "data": {
                "status": "accepted",
                "messageId": "user-02"
              }
            }
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.101\",\"type\":\"message.claimed\",\"data\":{\"requestId\":\"pet.send-01\",\"messageId\":\"user-02\",\"activityId\":\"activity-A\",\"turn\":2}}",
            "lastEventId": "bridge-A.101"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.105\",\"type\":\"assistant.delta\",\"data\":{\"activityId\":\"activity-A\",\"attemptId\":\"attempt-A\",\"index\":0,\"text\":\"已经找到\"}}",
            "lastEventId": "bridge-A.105"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.106\",\"type\":\"tool.started\",\"data\":{\"activityId\":\"activity-A\",\"callId\":\"call-A\",\"name\":\"read_file\",\"summary\":\"读取项目文件\"}}",
            "lastEventId": "bridge-A.106"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.109\",\"type\":\"tool.finished\",\"data\":{\"activityId\":\"activity-A\",\"callId\":\"call-A\",\"summary\":\"工具返回结果\",\"status\":\"completed\"}}",
            "lastEventId": "bridge-A.109"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.110\",\"type\":\"assistant.delta\",\"data\":{\"activityId\":\"activity-A\",\"attemptId\":\"attempt-A\",\"index\":1,\"text\":\"测试入口。\"}}",
            "lastEventId": "bridge-A.110"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.111\",\"type\":\"assistant.message\",\"data\":{\"messageId\":\"assistant-02\",\"turn\":2,\"text\":\"已经找到测试入口。\",\"attemptId\":\"attempt-A\"}}",
            "lastEventId": "bridge-A.111"
          }
        },
        {
          "direction": "host-to-pet",
          "event": {
            "type": "stream.event",
            "streamId": "sse.1",
            "event": "bridge",
            "data": "{\"protocol\":\"pet-dsh/1\",\"instanceId\":\"bridge-A\",\"sessionId\":\"session-A\",\"cursor\":\"bridge-A.112\",\"type\":\"activity.ended\",\"data\":{\"activityId\":\"activity-A\",\"outcome\":\"completed\"}}",
            "lastEventId": "bridge-A.112"
          }
        }
      ],
      "expected": [
        "stream.open 前不可写",
        "cursor 数字间隔合法",
        "authoritative assistant-02 只有一条",
        "结束状态 completed"
      ]
    },
