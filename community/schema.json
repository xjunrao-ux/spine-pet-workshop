{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spine Pet Workshop community plugin entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "description", "version", "apiVersion", "minHostVersion", "category", "sourceUrl", "downloadUrl", "sha256", "permissions", "license"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,99}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "author": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "apiVersion": {"type": "integer", "const": 1},
    "minHostVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "category": {"type": "string", "enum": ["学习示例", "效率工具", "天气", "开发工具", "其他"]},
    "sourceUrl": {"type": "string", "minLength": 1, "maxLength": 500},
    "downloadUrl": {"type": "string", "minLength": 1, "maxLength": 500},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "permissions": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "enum": ["storage.own", "ui.reminders", "weather.read", "codex.read", "ai.deepseek", "net.local"]}},
    "license": {"type": "string", "minLength": 1, "maxLength": 100}
  }
}
