#!/bin/sh
remote_name="$1"
if [ "$remote_name" != "public" ]; then
  exit 0
fi

is_release_tag() {
  case "$1" in v*) version=${1#v} ;; *) return 1 ;; esac
  old_ifs=$IFS
  IFS=.
  set -- $version
  IFS=$old_ifs
  [ "$#" -eq 3 ] || return 1
  for part in "$@"; do
    case "$part" in ''|*[!0-9]*) return 1 ;; esac
  done
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      tagged=false
      for tag in $(git tag --points-at "$local_sha"); do
        if is_release_tag "$tag"; then tagged=true; break; fi
      done
      if [ "$tagged" != true ]; then
        echo "Rejected: public/main must point to a vX.Y.Z release tag." >&2
        exit 1
      fi
      ;;
    refs/tags/*)
      if ! is_release_tag "${remote_ref#refs/tags/}"; then
        echo "Rejected: only vX.Y.Z release tags may be published." >&2
        exit 1
      fi
      ;;
    *)
      echo "Rejected: development branches must remain local. Push only main and a release tag." >&2
      exit 1
      ;;
  esac
  if [ -n "$(git rev-list "$local_sha" -- v3)" ]; then
    echo "Rejected: this history includes local v3 research commits. Prepare a release with squash." >&2
    exit 1
  fi
  if ! git ls-tree -r --name-only "$local_sha" | while IFS= read -r file; do
    case "$file" in
      v3/*|.local/*|artifacts/*|node_modules/*|release/*|releases/*|pet-source/*|vendor/*|public-repos/*|public/models/*|public/voicepacks/*)
        echo "Rejected: local-only content in release: $file" >&2
        exit 1
        ;;
    esac
  done; then
    exit 1
  fi
done
exit 0
